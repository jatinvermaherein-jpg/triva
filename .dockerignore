# Railway's Nixpacks/Docker builders honour THIS file, not .railwayignore (which is
# undocumented and only ever worked for the CLI uploader). A SQLite file baked into
# the image can resurface over the /data volume, which reads as "my season vanished
# after a deploy" - so database files are excluded explicitly, not by accident.
.git
.github
__pycache__/
*.pyc
.pytest_tmp/
*.db
*.db-wal
*.db-shm
*.db-journal
.venv/
.env
*.env
sim/
tests/
run_tests.py
Dockerfile
.dockerignore
README.md
STATUS.md
0*.md
# Deliberately NOT ignored: bot/ engine/ requirements.txt railway.json runtime.txt
# .python-version  (the two version pins must reach the builder, or it defaults to
# an ancient Python and the bot dies on `from zoneinfo import ZoneInfo`).
